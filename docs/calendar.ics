UID:cluster:aeb7b645-fb42-4ffd-8c56-3a62861f90a5@news.lavillerose.com
DTSTART;VALUE=DATE:20260626
DTEND;VALUE=DATE:20260627
SUMMARY:Événement AISC Airbus Stadium
