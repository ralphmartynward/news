<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Toulouse News — {{ date_long }}</title>
<style>
  :root { --ink: #1a1a1a; --muted: #6b6b6b; --rule: #e5e5e5; --accent: #c0392b; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: #fafafa;
  }
  .wrap { max-width: 720px; margin: 0 auto; padding: 32px 20px 64px; }

  header.top { border-bottom: 2px solid var(--ink); padding-bottom: 16px; margin-bottom: 24px; }
  header.top h1 {
    margin: 0;
    font-size: 36px;
    letter-spacing: -0.01em;
    font-weight: 800;
    text-transform: uppercase;
  }
  header.top .date { color: var(--muted); margin: 4px 0 0; font-size: 14px; }
  header.top nav { margin-top: 12px; font-size: 14px; }
  header.top nav a { color: var(--accent); text-decoration: none; margin-right: 16px; }
  header.top nav a:hover { text-decoration: underline; }

  section.subscribe {
    border: 1px solid var(--rule); background: #fff;
    padding: 16px; margin: 24px 0; border-radius: 6px;
  }
  section.subscribe h2 { margin: 0 0 8px; font-size: 16px; text-transform: uppercase; letter-spacing: 0.02em; }
  section.subscribe p.note { margin: 0 0 12px; color: var(--muted); font-size: 13px; }
  section.subscribe form { display: flex; gap: 8px; flex-wrap: wrap; }
  section.subscribe input[type=email] {
    flex: 1 1 200px; padding: 10px 12px; border: 1px solid var(--rule);
    border-radius: 4px; font: inherit;
  }
  section.subscribe button {
    padding: 10px 16px; border: 0; background: var(--ink); color: #fff;
    border-radius: 4px; font: inherit; cursor: pointer;
  }
  section.subscribe button:disabled { background: #999; cursor: not-allowed; }

  section.cat { margin: 32px 0; }
  section.cat h2 {
    font-size: 14px; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--muted); border-bottom: 1px solid var(--rule);
    padding-bottom: 6px; margin: 0 0 16px;
  }
  article { margin: 0 0 24px; }
  article h3 { margin: 0 0 4px; font-size: 19px; line-height: 1.3; font-weight: 700; }
  article h3 a { color: var(--ink); text-decoration: none; }
  article h3 a:hover { color: var(--accent); }
  article .meta { margin: 0 0 6px; color: var(--muted); font-size: 13px; }
  article p.summary { margin: 0; color: #333; }

  footer { border-top: 1px solid var(--rule); margin-top: 48px; padding-top: 16px; color: var(--muted); font-size: 13px; }
  footer a { color: var(--accent); text-decoration: none; }
  footer a:hover { text-decoration: underline; }
</style>
</head>
<body>
<div class="wrap">

<header class="top">
  <h1>Toulouse News</h1>
  <p class="date">{{ date_long }}</p>
  <nav>
    <a href="/feed.xml">RSS</a>
    <a href="#abonnement">S'abonner par email</a>
  </nav>
</header>

<section class="subscribe" id="abonnement">
  <h2>S'abonner par email</h2>
  <p class="note">Recevez le digest quotidien dans votre boîte mail.</p>
  <form id="subscribe-form" action="#" method="post" onsubmit="event.preventDefault(); alert('Le formulaire sera connecté à l\'étape suivante.');">
    <input type="email" name="email" placeholder="vous@exemple.com" required>
    <button type="submit">S'abonner</button>
  </form>
</section>

{% for section in sections %}
<section class="cat">
  <h2>{{ section.title }}</h2>
  {% for entry in section.entries %}
  <article>
    <h3><a href="{{ entry.url }}">{{ entry.title }}</a></h3>
    <p class="meta">{{ entry.source_label }} · {{ entry.published_label }}</p>
    {% if entry.summary %}<p class="summary">{{ entry.summary }}</p>{% endif %}
  </article>
  {% endfor %}
</section>
{% endfor %}

<footer>
  <p>{{ entry_count }} {{ "story" if entry_count == 1 else "stories" }} · <a href="/feed.xml">RSS</a></p>
</footer>

</div>
</body>
</html>
