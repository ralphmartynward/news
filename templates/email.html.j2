<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ subject }}</title>
<style>
  body { margin: 0; padding: 0; background: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #0f172a; }
  .wrap { max-width: 600px; margin: 0 auto; padding: 24px 16px 40px; }
  .header { border-bottom: 2px solid #0f172a; padding-bottom: 12px; margin-bottom: 24px; }
  .brand { font-size: 24px; font-weight: 900; letter-spacing: -0.3px; text-transform: uppercase; color: #0f172a; margin: 0; }
  .date { font-size: 13px; color: #64748b; margin: 4px 0 0; }
  .lead { font-size: 14px; color: #475569; line-height: 1.55; margin: 0 0 24px; }

  .sec { margin: 32px 0; }
  .sec-label { font-size: 10px; font-weight: 800; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.7px; margin: 0 0 4px; }
  .sec-title { font-size: 20px; font-weight: 900; color: #0f172a; margin: 0 0 16px; letter-spacing: -0.2px; }

  .entry { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: 16px; margin-bottom: 12px; }
  .entry-meta { font-size: 11px; margin-bottom: 6px; }
  .entry-source { display: inline-block; font-weight: 800; text-transform: uppercase; letter-spacing: 0.4px; border: 1px solid; border-radius: 999px; padding: 2px 8px; margin-right: 6px; }
  .cat-news    { color: #2563eb; background: #eff6ff; border-color: #dbeafe; }
  .cat-event   { color: #16a34a; background: #f0fdf4; border-color: #bbf7d0; }
  .cat-place   { color: #d97706; background: #fffbeb; border-color: #fde68a; }
  .cat-culture { color: #8b5cf6; background: #faf5ff; border-color: #e9d5ff; }
  .cat-other   { color: #475569; background: #f1f5f9; border-color: #e2e8f0; }
  .entry-time { color: #94a3b8; font-weight: 600; }
  .entry-title { font-size: 16px; font-weight: 800; line-height: 1.3; margin: 0 0 8px; }
  .entry-title a { color: #0f172a; text-decoration: none; }
  .entry-summary { font-size: 13px; color: #475569; line-height: 1.55; margin: 0 0 10px; }
  .entry-cta { font-size: 12px; font-weight: 800; }
  .entry-cta a { color: #2563eb; text-decoration: none; }

  .footer { border-top: 1px solid #e2e8f0; margin-top: 36px; padding-top: 16px; font-size: 12px; color: #94a3b8; text-align: center; line-height: 1.6; }
  .footer a { color: #64748b; text-decoration: none; }
</style>
</head>
<body>
<div class="wrap">

<div class="header">
  <h1 class="brand">Toulouse News</h1>
  <p class="date">{{ date_long }}</p>
</div>

<p class="lead">L'actu de la Ville Rose, agrégée pour vous. {{ entry_count }} {{ "story" if entry_count == 1 else "stories" }} aujourd'hui.</p>

{% for section in sections %}
<div class="sec">
  <p class="sec-label">{{ section.label }}</p>
  <h2 class="sec-title">{{ section.title }}</h2>
  {% for entry in section.entries %}
  <div class="entry">
    <div class="entry-meta">
      <span class="entry-source cat-{{ section.key }}">{{ entry.source_label }}</span>
      <span class="entry-time">{{ entry.published_label }}</span>
    </div>
    <h3 class="entry-title"><a href="{{ entry.url }}">{{ entry.title }}</a></h3>
    {% if entry.summary %}<p class="entry-summary">{{ entry.summary }}</p>{% endif %}
    <p class="entry-cta"><a href="{{ entry.url }}">Lire l'article →</a></p>
  </div>
  {% endfor %}
</div>
{% endfor %}

<div class="footer">
  <p>
    <a href="https://news.lavillerose.com/">Voir sur news.lavillerose.com</a>
    ·
    <a href="{% raw %}{{{RESEND_UNSUBSCRIBE_URL}}}{% endraw %}">Se désabonner</a>
  </p>
  <p style="margin-top:8px;font-size:11px;">
    Toulouse News — agrégateur quotidien d'actualités toulousaines.
  </p>
</div>

</div>
</body>
</html>
