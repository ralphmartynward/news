{% macro calendar_styles() %}
<style>
.cal-timeline { display: flex; flex-direction: column; }
.cal-day {
  display: grid; grid-template-columns: 96px 1fr; gap: 16px;
  padding: 14px 0; border-top: 1px solid rgba(0,0,0,0.06);
  align-items: start;
}
.cal-day--today { background: rgba(74,222,128,0.03); border-radius: 8px; padding: 14px 10px; margin: 0 -10px; }
.cal-day--past { opacity: 0.45; }
.cal-date-col { display: flex; flex-direction: column; gap: 1px; padding-top: 3px; }
.cal-date-num  { font-size: 26px; font-weight: 900; line-height: 1; color: #0f172a; }
.cal-date-week { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; }
.cal-date-mon  { font-size: 11px; color: #94a3b8; }
.cal-day--today .cal-date-num  { color: #4ade80; }
.cal-day--today .cal-date-week { color: #4ade80; opacity: 0.7; }
.cal-events-col { display: flex; flex-direction: column; gap: 8px; }
.cal-card {
  background: #fff; border: 1px solid rgba(0,0,0,0.08); border-radius: 10px;
  padding: 12px 14px; text-decoration: none; color: inherit; display: block;
  transition: border-color 150ms, box-shadow 150ms;
}
.cal-card:hover { border-color: #4ade80; box-shadow: 0 2px 10px rgba(74,222,128,0.12); }
.cal-card-title   { font-size: 14px; font-weight: 700; color: #0f172a; margin: 0 0 5px; line-height: 1.3; }
.cal-card:hover .cal-card-title { color: #16a34a; }
.cal-card-summary { font-size: 12px; color: #64748b; line-height: 1.5; margin: 0 0 8px; }
.cal-card-source  {
  font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.4px;
  color: #16a34a; background: #f0fdf4; border: 1px solid #bbf7d0;
  border-radius: 999px; padding: 2px 7px; display: inline-block;
}
.cal-today-bar {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 0 6px; margin: 6px 0 2px;
  font-size: 10px; font-weight: 800; text-transform: uppercase;
  letter-spacing: 0.8px; color: #4ade80;
}
.cal-today-bar::before, .cal-today-bar::after {
  content: ''; flex: 1; height: 1px; background: rgba(74,222,128,0.25);
}
/* Compact variant for landing page widget */
.cal-compact .cal-day  { grid-template-columns: 72px 1fr; gap: 10px; padding: 10px 0; }
.cal-compact .cal-date-num  { font-size: 20px; }
.cal-compact .cal-card { padding: 8px 12px; }
.cal-compact .cal-card-title { font-size: 13px; margin-bottom: 0; }
.cal-compact .cal-card-summary { display: none; }
@media (max-width: 600px) {
  .cal-day { grid-template-columns: 56px 1fr; gap: 10px; }
  .cal-date-num { font-size: 20px; }
  .cal-date-mon { display: none; }
}
</style>
{% endmacro %}

{% macro render_calendar(days, compact=false) %}
<div class="cal-timeline {% if compact %}cal-compact{% endif %}">
  {% set ns = namespace(past_done=false) %}
  {% for day in days %}
    {% if not ns.past_done and not day.is_past %}
      {% if loop.index0 > 0 %}
      <div class="cal-today-bar">Aujourd'hui et à venir</div>
      {% endif %}
      {% set ns.past_done = true %}
    {% endif %}
    <div class="cal-day {% if day.is_today %}cal-day--today{% elif day.is_past %}cal-day--past{% endif %}">
      <div class="cal-date-col">
        <span class="cal-date-week">{{ day.date_label.split(' ')[0] }}</span>
        <span class="cal-date-num">{{ day.date_label.split(' ')[1] }}</span>
        <span class="cal-date-mon">{{ day.date_label.split(' ')[2] if day.date_label.split(' ')|length > 2 else '' }}</span>
      </div>
      <div class="cal-events-col">
        {% for ev in day.events %}
        <a class="cal-card" href="{{ ev.url }}" target="_blank" rel="noopener">
          <div class="cal-card-title">{{ ev.title }}</div>
          {% if not compact and ev.summary %}
          <p class="cal-card-summary">{{ ev.summary }}</p>
          {% endif %}
          <span class="cal-card-source">{{ ev.source_label }}</span>
        </a>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <p style="color:#94a3b8;font-size:13px;padding:16px 0;">Aucun événement avec dates structurées pour le moment.</p>
  {% endfor %}
</div>
{% endmacro %}
